cd ~/dto_converter

cat > .gitignore << 'EOF'
# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment
.env

# IDE
.vscode/
.idea/
.DS_Store

# Go binary (rebuild via 'make build')
src/go-ast-parser/parser

# Runtime state
state/.sync_state
state/changes.json
EOF*_old.*

# Local backup files (никогда не коммитим)
*_old.*
* copy.*
* copy 2.*
* copy 3.*
* copy 4.*
* copy 5.*
* copy 6.*
* copy 7.*
* copy 8.*
* copy 9.*
