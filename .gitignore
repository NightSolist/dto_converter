cd ~/dto_converter

cat > .gitignore << 'EOF'
# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Environment
.env

# IDE
.vscode/
.idea/
.DS_Store

# Go binary (rebuild via 'make build')
src/go-ast-parser/parser

# Runtime state
state/.sync_state
state/changes.json
EOF